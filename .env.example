# Copy the variables you need into .env (git-ignored) and fill in the values.
# Never put real secrets into this file: it is committed.

# --- API service: PostgreSQL (docker-compose.yml and src/settings.py) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=proposal
POSTGRES_DB=proposal
# Required. Letters and digits only: "$" and "#" have a special meaning in .env
POSTGRES_PASSWORD=

# --- LLM extraction (optional; CLI tender mode, Streamlit, eval) ---
# Not used by the API service. Uncomment to enable.
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT=120
